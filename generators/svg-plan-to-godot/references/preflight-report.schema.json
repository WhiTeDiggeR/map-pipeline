{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SVG plan preflight report",
  "type": "object",
  "required": ["inspector_version", "source", "profile", "view_box", "summary", "recognized", "explicitly_ignored", "unrecognized", "invalid"],
  "properties": {
    "inspector_version": {"type": "string"},
    "source": {"type": "string"},
    "profile": {"enum": ["generic", "codex-plan"]},
    "view_box": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "summary": {
      "type": "object",
      "required": ["recognized", "explicitly_ignored", "unrecognized", "invalid"],
      "properties": {
        "recognized": {"type": "integer", "minimum": 0},
        "explicitly_ignored": {"type": "integer", "minimum": 0},
        "unrecognized": {"type": "integer", "minimum": 0},
        "invalid": {"type": "integer", "minimum": 0}
      }
    },
    "recognized": {"type": "array", "items": {"$ref": "#/$defs/recognized"}},
    "explicitly_ignored": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
    "unrecognized": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
    "invalid": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "recognized": {
      "type": "object",
      "required": ["id", "tag", "type", "classes", "path_count"],
      "properties": {
        "id": {"type": "string"}, "tag": {"type": "string"}, "type": {"type": "string"},
        "classes": {"type": "string"}, "path_count": {"type": "integer", "minimum": 0}
      }
    },
    "unresolved": {
      "type": "object",
      "required": ["id", "tag", "classes", "reason"],
      "properties": {
        "id": {"type": "string"}, "tag": {"type": "string"},
        "classes": {"type": "string"}, "reason": {"type": "string"}
      }
    }
  }
}
