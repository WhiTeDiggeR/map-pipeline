{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SVG plan conversion report",
  "type": "object",
  "required": ["generator_version", "source", "scene", "settings", "view_box", "profile", "counts", "assumptions", "warnings", "errors", "ignored", "materials", "created_materials", "preserved_materials", "files"],
  "properties": {
    "generator_version": {"type": "string"},
    "source": {"type": "string"},
    "scene": {"type": "string"},
    "settings": {"type": "object"},
    "view_box": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "profile": {"enum": ["generic", "codex-plan"]},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "ignored": {"type": "array", "items": {"type": "object"}},
    "materials": {"type": "object", "additionalProperties": {"type": "string"}},
    "created_materials": {"type": "array", "items": {"type": "string"}},
    "preserved_materials": {"type": "array", "items": {"type": "string"}},
    "files": {"type": "array", "items": {"type": "string"}, "minItems": 4}
  }
}
